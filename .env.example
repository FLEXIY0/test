# Copy to .env and adjust. Secrets (API keys) go in ./secrets/, NOT here.

# --- Voiceover (edge-tts, free, no key) ---
# Deep, warm US male voices suit the 55+ nostalgia niche.
# Try: en-US-ChristopherNeural, en-US-RogerNeural, en-US-GuyNeural
VOICE=en-US-ChristopherNeural
VOICE_RATE=-8%

# --- Video ---
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
MUSIC_FILE=assets/calm_background.mp3   # optional; leave blank for no music
MUSIC_VOLUME=0.10

# --- Quality gates ---
MIN_DURATION_S=240
MAX_DURATION_S=900
MIN_IMAGES=5

# --- Claude script generation (optional; --topic) ---
CLAUDE_MODEL=claude-opus-4-8
