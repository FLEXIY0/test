# Copy to .env and adjust. Secrets (API keys) go in ./secrets/, NOT here.

# --- Voiceover (edge-tts, free, no key) ---
# Deep, warm US male voices suit the 55+ nostalgia niche.
# Try: en-US-ChristopherNeural, en-US-RogerNeural, en-US-GuyNeural
VOICE=en-US-ChristopherNeural
VOICE_RATE=-8%

# --- Video ---
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
MUSIC_FILE=assets/calm_background.mp3   # optional; leave blank for no music
MUSIC_VOLUME=0.10

# --- Visuals ---
IMAGES_PER_SEGMENT=2        # stills per narration segment (visual variety)
CANDIDATES_PER_QUERY=4      # downloaded per [IMAGE:] query for curation
MIN_IMAGE_WIDTH=800         # reject smaller candidates
XFADE_S=0.6                 # crossfade between stills within a segment
# IMAGE_UA_CONTACT=you@example.com   # contact for Wikimedia's UA policy

# --- Quality gates ---
MIN_DURATION_S=240
MAX_DURATION_S=900
MIN_IMAGES=5

# --- Script generation (optional; used only with --topic) ---
# Pick which AI writes the script: claude | gemini | qwen
SCRIPT_PROVIDER=claude
MAX_OUTPUT_TOKENS=16000

# Claude (Anthropic) — key goes in secrets/anthropic_api_key
CLAUDE_MODEL=claude-opus-4-8

# Gemini (Google) — key goes in secrets/gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Qwen (Alibaba DashScope, OpenAI-compatible) — key in secrets/dashscope_api_key
QWEN_MODEL=qwen-plus
# International endpoint; for mainland China use
# https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
