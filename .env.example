# ---------------------------------------------------------------------------
# Non-secret runtime configuration. Copy to .env and adjust.
# API KEYS DO NOT BELONG HERE — use Docker secrets (see docker-compose.yml
# and docs/SECURITY.md).
# ---------------------------------------------------------------------------

# Venues (ccxt ids) and instruments
EXCHANGES=binance,kraken
SYMBOLS=BTC/USDT,ETH/USDT

# Per-venue taker/maker fee schedule (decimal; verify against your fee tier)
BINANCE_TAKER_FEE=0.001
BINANCE_MAKER_FEE=0.001
KRAKEN_TAKER_FEE=0.0026
KRAKEN_MAKER_FEE=0.0016

# Strategy thresholds
MIN_EDGE_BPS=8                 # fire only above 8 bps net of fees
MAX_NOTIONAL_PER_TRADE=500     # quote units per trade
BOOK_MAX_AGE_MS=750            # discard opportunities priced on stale books
BOOK_DEPTH=25
TRADE_COOLDOWN_S=1.0

# Rebalancing / profit sweep (withdrawals stay OFF until explicitly enabled)
REBALANCE_SKEW_THRESHOLD=0.35
REBALANCE_INTERVAL_S=300
ENABLE_WITHDRAWALS=false
PROFIT_SWEEP_ADDRESS=
PROFIT_SWEEP_NETWORK=
PROFIT_SWEEP_MIN_QUOTE=1000

# Runtime
DRY_RUN=true                   # paper-trade first; flip to false deliberately
LOG_LEVEL=INFO
HEALTH_PORT=8080
BACKOFF_BASE_S=1.0
BACKOFF_CAP_S=60
